# Flask
FLASK_ENV=development
FLASK_RUN_PORT=5000

# --- Pi-hole (v6 API) ---
# Base URL of your Pi-hole box, no trailing slash, no /api suffix.
PIHOLE_HOST=http://pi.hole
# Generate this in the Pi-hole v6 web UI: Settings > API > App Password.
PIHOLE_APP_PASSWORD=changeme
PIHOLE_VERIFY_TLS=true
PIHOLE_TIMEOUT=5

# --- Network health ---
NETWORK_PING_HOST=1.1.1.1
NETWORK_PING_COUNT=5
NETWORK_PING_TIMEOUT=5

EXTERNAL_IP_API_URL=https://ipapi.co/json/
EXTERNAL_IP_TIMEOUT=5
EXTERNAL_IP_CACHE_TTL=3600

# --- Pi Zero system health ---
SYSTEM_DISK_PATH=/

# --- Query rate anomaly detection ---
# Flags when queries/min spikes above (baseline * ANOMALY_MULTIPLIER), as
# long as it's also above the ANOMALY_MIN_QPM floor (avoids flagging tiny
# absolute upticks during quiet periods when the baseline is near zero).
# ANOMALY_HISTORY_SIZE is how many past poll-to-poll rate samples make up
# the rolling baseline (12 samples ~= 1 hour at the poller's 5-min cadence).
ANOMALY_HISTORY_SIZE=12
ANOMALY_MULTIPLIER=3.0
ANOMALY_MIN_QPM=5.0
ANOMALY_MIN_SAMPLES=3

# --- New device detection ---
# Devices from Pi-hole's /api/network/devices, diffed against this file
# (persisted to disk, not reset by a Flask restart like the anomaly
# tracker above). Defaults to data/known_devices.json under the project
# root — uncomment to override:
# DEVICE_KNOWN_FILE=/home/pi/epaper-dashboard/data/known_devices.json

# --- Dashboard client (poller/render script) ---
DASHBOARD_API_BASE=http://127.0.0.1:5000
